// attendance-web/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// เลิกใช้ Enum ตามความต้องการเดิม แล้วเปลี่ยนไปใช้ String ปกติใน model แทน 
// แต่สำหรับ Role ยังคงเก็บไว้ตามเดิมที่คุณใช้งานอยู่
enum Role {
  ADMIN
  TEACHER
  STUDENT  
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique 
  password  String
  role      Role     @default(STUDENT) 
  
  admin     Admin?
  teacher   Teacher?
  student   Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName   String   // ชื่อจริง
  lastName    String   // นามสกุล
  employeeId  String?  @unique // รหัสพนักงาน (ถ้ามี)
}

model Teacher {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName   String   // ชื่อจริง
  lastName    String   // นามสกุล
  
  courses     Course[]
}

model Course {
  id           String   @id @default(cuid())
  
  // 🚀 1. ปรับปรุง: เอา @unique ออกจาก courseCode เพื่อให้อาจารย์ 1 คน หรืออาจารย์หลายคนเปิดสอนวิชาเดียวกันซ้ำได้
  courseCode   String   
  courseName   String
  
  // 🚀 2. เพิ่มเติม: โครงสร้างสำหรับจัดการชั้นเรียน (Classroom Instance)
  section      String   @default("1") // กลุ่มเรียน เช่น "1", "2"
  semester     String   // ภาคเรียน เช่น "1", "2", "3" (ซัมเมอร์)
  academicYear String   // ปีการศึกษา เช่น "2569"
  
  // 🚀 3. เพิ่มเติม: รหัสเข้าชั้นเรียนสำหรับให้นักศึกษากรอกเพื่อ Join Class
  joinCode     String   @unique

  status       String   @default("ACTIVE") // 'ACTIVE', 'ARCHIVED'
  
  teacherId    Int
  teacher      Teacher  @relation(fields: [teacherId], references: [id])
  
  students     Student[]
  attendances  Attendance[]
  sessions     AttendanceSession[] // เชื่อมโยงกับรอบการเช็คชื่อ
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt 
}

model Student {
  id          Int      @id @default(autoincrement())
  studentCode String   @unique
  firstName   String   // ชื่อจริง
  lastName    String   // นามสกุล
  password    String   
  faceVectors String?  
  
  userId      String?  @unique 
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  courses     Course[]
  attendances Attendance[]
}

// ตารางสำหรับเก็บบันทึกรอบการเช็คชื่อและรูปภาพที่อัปโหลดสแกน
model AttendanceSession {
  id          String       @id @default(cuid())
  roundNumber Int          // ครั้งที่ 1, 2, 3...
  imageUrl    String?      // Path หรือ URL รูปภาพที่ใช้อัปโหลดเช็คชื่อ
  note        String?      // หมายเหตุเพิ่มเติมของรอบนั้นๆ
  
  // 🚀 เพิ่มเติม: เพื่อช่วยในการจัดกลุ่มสัปดาห์ (คาบปกติ / คาบชดเชย) 
  // และให้ระบุเวลาเช็คชื่อของรอบนั้นๆ ชัดเจน
  sessionType String       @default("REGULAR") // 'REGULAR', 'COMPENSATION'
  timeSlot    String?      // ช่วงเวลาเรียน เช่น "09:00-12:00"

  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  attendances Attendance[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Attendance {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now()) 
  status      String   
  imagePath   String?  
  
  // ฟิลด์สำหรับบันทึกการแก้ไขด้วยตนเอง
  isManual    Boolean  @default(false)
  remark      String?  // เหตุผลหรือหมายเหตุ เช่น "ลาป่วย มีใบรับรองแพทย์"
  updatedAt   DateTime @updatedAt

  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])

  // เชื่อมโยงกับรอบการเช็คชื่อแบบ Optional
  sessionId   String?
  session     AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
}