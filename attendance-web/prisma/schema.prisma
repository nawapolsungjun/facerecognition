generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT  
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique 
  password  String
  role      Role     @default(STUDENT) 
  
  admin     Admin?
  teacher   Teacher?
  student   Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName   String   // ชื่อจริง
  lastName    String   // นามสกุล
  employeeId  String?  @unique // รหัสพนักงาน (ถ้ามี)
}

model Teacher {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName   String   // ชื่อจริง
  lastName    String   // นามสกุล
  
  courses     Course[]
}

model Course {
  id          String   @id @default(cuid())
  courseCode  String   @unique
  courseName  String
  status      String   @default("ACTIVE")
  
  teacherId   Int
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  
  students    Student[]
  attendances Attendance[]
  sessions    AttendanceSession[] // เชื่อมโยงกับรอบการเช็คชื่อ
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt 
}

model Student {
  id          Int      @id @default(autoincrement())
  studentCode String   @unique
  firstName   String   // ชื่อจริง
  lastName    String   // นามสกุล
  password    String   
  faceVectors String?  
  
  userId      String?  @unique 
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  courses     Course[]
  attendances Attendance[]
}

// ตารางสำหรับเก็บบันทึกรอบการเช็คชื่อและรูปภาพที่อัปโหลดสแกน
model AttendanceSession {
  id          String       @id @default(cuid())
  roundNumber Int          // ครั้งที่ 1, 2, 3...
  imageUrl    String?      // Path หรือ URL รูปภาพที่ใช้อัปโหลดเช็คชื่อ
  note        String?      // หมายเหตุเพิ่มเติมของรอบนั้นๆ
  
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  attendances Attendance[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Attendance {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now()) 
  status     String   
  imagePath  String?  
  
  // ฟิลด์สำหรับบันทึกการแก้ไขด้วยตนเอง
  isManual   Boolean  @default(false)
  remark     String?  // เหตุผลหรือหมายเหตุ เช่น "ลาป่วย มีใบรับรองแพทย์"
  updatedAt  DateTime @updatedAt

  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id])
  
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])

  // เชื่อมโยงกับรอบการเช็คชื่อแบบ Optional
  sessionId  String?
  session    AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
}